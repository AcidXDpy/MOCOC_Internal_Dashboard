{
  "name": "mococ-internal-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint src api scripts",
    "format": "prettier --write \"{src,api,scripts}/**/*.{ts,tsx}\" \"*.{json,js,ts,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,api,scripts}/**/*.{ts,tsx}\" \"*.{json,js,ts,md}\" \"docs/**/*.md\"",
    "data:init": "tsx scripts/initialize-intelligence.ts",
    "data:refresh-census": "tsx scripts/refresh-census.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.49",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
